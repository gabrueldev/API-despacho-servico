DJANGO_SECRET_KEY=troque-isto
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://despacha:despacha@db:5432/despacha
REDIS_URL=redis://redis:6379/0
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ACEITE_TIMEOUT_SEGUNDOS=120
RAIO_BUSCA_KM=30
RASTREIO_VALIDADE_HORAS=24
LOCALIZACAO_FLUSH_SEGUNDOS=60
IDEMPOTENCY_TTL_HORAS=24
DB_POOL_MAX=10
# Só fora do Docker (macOS/Homebrew):
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib
# Distância do chamado: linha_reta (padrão) ou osrm (km por estrada; suba com --profile rota).
DISTANCIA_PROVEDOR=linha_reta
OSRM_URL=http://osrm:5000
OSRM_TIMEOUT_SEGUNDOS=2
DISTANCIA_FATOR_ESTIMATIVA=1.3
# Mapa do OSRM (Geofabrik). Outra região: troque a URL e apague o volume `osrm`.
# OSRM_PBF_URL=https://download.geofabrik.de/south-america/brazil/sudeste-latest.osm.pbf
